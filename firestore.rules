rules_version = '2';
// Tienda The White Hilux
//  - tienda/catalogo: precios, estados, stock y ajustes. Lo lee cualquiera (la tienda); solo el admin lo edita.
//  - pedidos/*: solo el admin los ve y edita. Los crean las funciones (Admin SDK, no pasan por estas reglas).
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['tmontes30@gmail.com'];
    }

    match /tienda/catalogo {
      allow read: if true;
      allow write: if isAdmin();
    }

    // El admin puede crear ventas manuales (transferencia/efectivo); los pedidos web los crean las funciones
    match /pedidos/{id} {
      allow read, update, delete, create: if isAdmin();
    }

    // Códigos de descuento: privados (el cliente solo los valida a través de la función validarCupon)
    match /cupones/{code} {
      allow read, write: if isAdmin();
    }

    // Ajustes privados (comisión estimada, empaque): solo el admin
    match /privado/{id} {
      allow read, write: if isAdmin();
    }

    // Compras a proveedores (costos): solo el admin
    match /compras/{id} {
      allow read, write: if isAdmin();
    }

    // Dispositivos del admin suscritos a notificaciones push (los usa la función que avisa pedidos)
    match /pushSubs/{id} {
      allow read, write: if isAdmin();
    }

    // Visitas de la tienda (anónimas, sumadas por día). Las escribe la función "evento"; solo el admin las ve
    match /estadisticas/{dia} {
      allow read: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
